<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="false">
  <code><![CDATA[; FEARLUS-0 -- a conceptual model of land use decision-making
; Copyright (C) 2025  The James Hutton Institute
;
